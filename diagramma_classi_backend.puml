package "backend.entità" #DDDDDD {

    class Docente {
        - nome: String
        + Docente(nome: String)
        + getNome(): String
        + toString(): String
        + equals(o: Object): boolean
        + hashCode(): int
    }

    class Classe {
        - anno: int
        - sezione: char
        - indirizzo: String
        + Classe(anno: int, sezione: char, indirizzo: String)
        + getAnno(): int
        + getSezione(): char
        + getIndirizzo(): String
        + getChiave(): String
        + toString(): String
        + equals(o: Object): boolean
        + hashCode(): int
    }

    class Materia {
        - nome: String
        + Materia(nome: String)
        + getNome(): String
        + toString(): String
        + equals(o: Object): boolean
    }

    class Lezione {
        - docente: Docente
        - docenteCompresenza: Docente
        - classe: Classe
        - materia: Materia
        - oreSettimanali: int
        + Lezione(docente: Docente, classe: Classe, materia: Materia, oreSettimanali: int)
        + Lezione(docente: Docente, docenteCompresenza: Docente, classe: Classe, materia: Materia, oreSettimanali: int)
        + getDocente(): Docente
        + getDocenteCompresenza(): Docente
        + hasCompresenza(): boolean
        + getNomiDocenti(): String
        + getClasse(): Classe
        + getMateria(): Materia
        + getOreSettimanali(): int
        + toString(): String
    }

    class Slot {
        - lezione: Lezione
        - indice: int = -1
        - assegnato: boolean
        {static} + ORE_GIORNO: int = 9
        {static} + GIORNI_SETTIMANA: int = 5
        + Slot(lezione: Lezione, indice: int)
        + Slot(lezione: Lezione)
        + getLezione(): Lezione
        + getIndice(): int
        + isAssegnato(): boolean
        + setAssegnato(assegnato: boolean): void
        + assegna(giorno: int, ora: int): void
        {static} + vuoto(giorno: int, ora: int): Slot
        + isVuoto(): boolean
        + indexGiorno(): int
        + indexOra(): int
        + toString(): String
        + equals(o: Object): boolean
        + hashCode(): int
    }

    class Istituto {
        - docentiUni: List<Docente>
        - classiUni: List<Classe>
        - classi_tabelleh: HashMap<String, ArrayList<Slot>>
        - docenti_tabelleh: HashMap<String, ArrayList<Slot>>
        + Istituto(classiUni: Set<Classe>, docentiUni: Set<Docente>)
        + getDocentiUni(): List<Docente>
        + getClassiUni(): List<Classe>
        + getDocenti_tabelleh(): HashMap<String, ArrayList<Slot>>
        + getClassi_tabelleh(): HashMap<String, ArrayList<Slot>>
        + setHforDocente(key: String, orarioGenerated: ArrayList<Slot>): void
        + setHforClasse(key: String, orarioGenerated: ArrayList<Slot>): void
        + deduciOrariProf(): void
    }

    record Preferenza {
        - docente: String
        - giornoLibero: String
        - limiteH: int
        - noPrimaH: boolean
        - noUltimaH: boolean
        - riduciOreBuche: boolean
        + Preferenza(docente: String, giornoLibero: String, limiteH: int, noPrimaH: boolean, noUltimaH: boolean)
        + docente(): String
        + giornoLibero(): String
        + limiteH(): int
        + noPrimaH(): boolean
        + noUltimaH(): boolean
        + riduciOreBuche(): boolean
        + toString(): String
    }

    record ConfiguraVincoli {
        - nomeScuola: String
        - preferenze: List<Preferenza>
        + nomeScuola(): String
        + preferenze(): List<Preferenza>
    }

    enum Giorni {
        LUNEDI
        MARTEDI
        MERCOLEDI
        GIOVEDI
        VENERDI
        - nome: String
        - Giorni(nome: String)
        + getNome(): String
    }

    enum OrarioLezioni {
        PRIMA
        SECONDA
        TERZA
        QUARTA
        QUINTA
        SESTA
        PAUSA
        SETTIMA
        OTTAVA
        - nome: String
        - OrarioLezioni(nome: String)
        + getNome(): String
        {static} + getNome(index: int): String
    }

    enum PlessoScuola {
        SSS
        MAT
        TUR
        SIA
        AFM
        INFO
        CAT
        - nome: String
        - PlessoScuola(nome: String)
        + getNome(): String
        {static} + plessoSaraceno(): List<String>
        {static} + plessoRomegialli(): List<String>
    }
}

package "backend.algoritmo" #AAFF99 {

    class GenOrario {
        {static} # GIORNI: int = 5
        {static} # ORE: int = 9
        # docentiUsati: Set<String>
        # oreDocenteGiorno: Map<String, int[]>
        # erroriClassi: Map<String, List<String>>
        {static} + isSlotEsistente(giorno: int, ora: int): boolean
        {static} + ultimaOraGiorno(giorno: int): int
        + genOrarioOnClasse(tutteLeLezioni: List<Lezione>, keyClasse: String): List<Slot>
        + generaCasuale(lezioni: List<Lezione>): List<Slot>
        # generaCasualePerClasse(lezioni: List<Lezione>, keyClasse: String): List<Slot>
        + espandiInSlot(lezioni: List<Lezione>): List<Slot>
        # getSlotLiberi(occupato: boolean[][], nomeDocente: String, rnd: Random): List<int[]>
        # getSlotLiberi(occupato: boolean[][], doc1: String, doc2: String, rnd: Random): List<int[]>
        # ordinaSlotLiberi(liberi: List<int[]>, nomeDocente: String): void
        # ordinaSlotLiberi(liberi: List<int[]>, doc1: String, doc2: String): void
        + getDocentiUsati(): Set<String>
        + getErroriClassi(): Map<String, List<String>>
        # isSlotValido(nomeDocente: String, giorno: int, ora: int): boolean
        # registra(nomeDocente: String, giorno: int, ora: int): void
        # chiaveDocente(nomeDocente: String, giorno: int, ora: int): String
        # clonaOre(source: Map<String, int[]>): Map<String, int[]>
        # ripristinaOre(backup: Map<String, int[]>): void
        + generaIstituto(r: ReadCsv, lessons: List<Lezione>, cartella: String): Istituto
    }

    class GenOrarioVincoli {
        - vincoli: ConfiguraVincoli
        - preferenzeDocenti: Map<String, Preferenza>
        + GenOrarioVincoli(cfg: ConfiguraVincoli)
        + GenOrarioVincoli()
        + getVincoli(): ConfiguraVincoli
        + getPreferenzaDocente(nomeDocente: String): Preferenza
        # isSlotValido(nomeDocente: String, giorno: int, ora: int): boolean
        # ordinaSlotLiberi(liberi: List<int[]>, doc1: String, doc2: String): void
        + calcolaPenalitaSoft(nomeDocente: String, giorno: int, ora: int): int
        + getOreDocenteNelGiorno(nomeDocente: String, giorno: int): List<Integer>
        {static} + calcolaOreBucheGiorno(ore: List<Integer>): int
        {static} + indiceGiorno(nomeGiorno: String): int
        {static} + generaConVincoli(r: ReadCsv, lezioni: List<Lezione>, cartella: String): Istituto
        {static} + analizzaOrario(vincoli: ConfiguraVincoli, school: Istituto): Map<String, RisultatoVerificaDocente>
    }

    class RisultatoVerificaDocente {
        + docente: String
        + totOre: int
        + oreGiorno: int[]
        + oreBucheTotali: int
        + violazioneGiornoLibero: boolean
        + violazioneNoPrimaH: boolean
        + violazioneNoUltimaH: boolean
        + violazioneLimiteH: boolean
        + violazioneContemporaneita: boolean
        + motivazioniNonSoddisfatte: List<String>
        + RisultatoVerificaDocente(docente: String, totOre: int, oreBucheTotali: int)
        + hardRispettati(): boolean
        + haSegnalazioni(): boolean
        + getElencoSegnalazioni(): List<String>
    }
}

